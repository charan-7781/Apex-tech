# SAVE KAROO — Environment Variables & API Secrets Example
# Copy this file to .env and configure your keys.

# Platform Operational Mode (LIVE_DEMO / PRODUCTION)
SAVE_KAROO_ENV=LIVE_DEMO

# Google Gemini API Key (for live AI conversational reasoning in KAROO AI)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional alternate provider)
OPENAI_API_KEY=your_openai_api_key_here

# Razorpay Test Mode Credentials (for optional Citizen Pro / Enterprise Subscriptions)
RAZORPAY_KEY_ID=rzp_test_SaveKaroo2026
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Emergency Helpline Configuration
EMERGENCY_HELPLINE_PRIMARY=112
EMERGENCY_HELPLINE_WOMEN=1091
EMERGENCY_HELPLINE_TRAFFIC=1095
